@{
    ViewData["Title"] = "About";
}

<section class="page-hero text-center">
    <span class="section-badge">About Our Platform</span>
    <h1 class="display-5 fw-bold mt-3">A Marketplace Designed for Student Life</h1>
    <p class="lead text-muted mx-auto hero-text">
        Campus Marketplace is a student-focused digital platform that makes it easier for university students
        to discover practical products, connect with peers, and access a more efficient campus buying experience.
    </p>
</section>

<section class="row g-4 mt-4">
    <div class="col-md-6">
        <div class="info-card h-100">
            <h3>Our Mission</h3>
            <p class="text-muted mb-0">
                Our mission is to provide students with a professional and accessible marketplace where they can
                find useful products, save time, reduce unnecessary costs, and benefit from a platform built around campus needs.
            </p>
        </div>
    </div>

    <div class="col-md-6">
        <div class="info-card h-100">
            <h3>Our Vision</h3>
            <p class="text-muted mb-0">
                We envision a smarter campus environment where students can access a trusted marketplace experience
                that supports convenience, connection, and a stronger student community.
            </p>
        </div>
    </div>
</section>

<section class="row g-4 mt-2">
    <div class="col-lg-4">
        <div class="feature-panel h-100">
            <h4>Who We Help</h4>
            <p class="text-muted mb-0">
                Campus Marketplace is built for university students who need affordable, practical, and easy access to useful products.
            </p>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="feature-panel h-100">
            <h4>Why It Matters</h4>
            <p class="text-muted mb-0">
                Students often need technology, accessories, and study tools quickly. This platform helps make product discovery easier and more organized.
            </p>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="feature-panel h-100">
            <h4>What Makes It Different</h4>
            <p class="text-muted mb-0">
                Unlike general marketplaces, this platform is tailored to campus behavior, student routines, and practical academic needs.
            </p>
        </div>
    </div>
</section>

<section class="mt-5">
    <div class="brand-story-box">
        <h2 class="fw-bold mb-3">A Brand with Purpose</h2>
        <p class="text-muted mb-0">
            Campus Marketplace is more than a simple product page. It represents a digital solution that responds to real student challenges:
            limited time, limited budgets, and the need for a cleaner and more focused buying experience. By combining structured design,
            user-friendly navigation, and database-backed functionality, the platform creates a modern and professional campus marketplace concept.
        </p>
    </div>
</section>

<section class="text-center mt-5">
    <p class="small text-muted">
        Developed as part of the ITGN 350 Assignment while following professional web design, ASP.NET MVC structure, and database integration practices.
    </p>
</section>