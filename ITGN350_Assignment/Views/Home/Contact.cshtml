@model ITGN350_Assignment.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Contact";
}

<section class="page-hero text-center mb-4">
    <span class="section-badge">Contact & Support</span>
    <h1 class="display-5 fw-bold mt-3">We’d Love to Hear From You</h1>
    <p class="lead text-muted mx-auto hero-text">
        Send us your question, feedback, or message and our team will get back to you as soon as possible.
    </p>
</section>

<div class="row justify-content-center g-4">
    <div class="col-lg-4">
        <div class="side-auth-card h-100">
            <h3 class="fw-bold">Support Information</h3>
            <p class="text-muted">
                Campus Marketplace is built to provide a smooth and professional student experience.
            </p>

            <ul class="auth-points">
                <li>Email support for inquiries</li>
                <li>Fast response workflow</li>
                <li>Student-centered communication</li>
            </ul>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow border-0">
            <div class="card-body p-5">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                <form asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control form-control-lg" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control form-control-lg" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Message" class="form-label"></label>
                        <textarea asp-for="Message" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Send Message</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}